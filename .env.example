# Hugging Face token. Only needed for gated repos; all shipped profiles are public.
HF_TOKEN=
# Force a GPU profile dir instead of auto-detecting from nvidia-smi: 5090 | a100-80 | h100-80 | h200
PROFILE=
# Model id under profiles/<gpu>/ (e.g. gpt-oss-120b). Empty = that GPU's default. `gpu-llm up` sets this.
MODEL=
# Bearer token vLLM requires on /v1/*. `gpu-llm up` sets this to your ~/.gpu-llm/llm_api_key.
VLLM_API_KEY=
# Override the profile's max_model_len (e.g. lower it after an OOM).
MAX_MODEL_LEN=
